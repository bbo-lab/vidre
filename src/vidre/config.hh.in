/// @file
#ifndef VIDRE_CONFIG_HH
#define VIDRE_CONFIG_HH
#pragma once

/** General namespace.
 * @ingroup api */
namespace vidre {}

/**@addtogroup api-config
 * @details
 * @fileinfo
 * 
 * Compile-time support macros (such as version information or API/ABI related
 * declarations).
 * */

/**@defgroup api-config-version Version information
 * @ingroup api-config
 * */
///@{

/** Major version. */
#define VIDRE_VERSION_MAJOR @Vidre_VERSION_MAJOR@

/** Minor version. */
#define VIDRE_VERSION_MINOR @Vidre_VERSION_MINOR@

/** Version string (major.minor). */
#define VIDRE_VERSION_S "@Vidre_VERSION_MAJOR@.@Vidre_VERSION_MINOR@"

/** Tiny (or patch, respectively) version. */
#define VIDRE_VERSION_PATCH @Vidre_VERSION_PATCH@

/** Release string (major.minor.patch). */
#define VIDRE_RELEASE_S "@Vidre_VERSION_MAJOR@.@Vidre_VERSION_MINOR@.@Vidre_VERSION_PATCH@"

///@}

/**@defgroup api-config-paths Installation paths
 * @ingroup api-config
 * */
///@{

/** Installation prefix. */
#define VIDRE_INSTALL_PREFIX "@CMAKE_INSTALL_PREFIX@"

/** Plugin directory. */
#define VIDRE_INSTALL_PLUGINDIR "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_PLUGINDIR@"

/** Script directory. */
#define VIDRE_INSTALL_SCRIPTDIR "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_SCRIPTDIR@"

///@}

/**@defgroup api-config-abi API/ABI and system settings
 * @ingroup api-config
 * */
///@{

/** Import library symbols. 
 * @see e.g. VIDRE_CORE_VISIBILITY */
#define VIDRE_API_IMPORT @VIDRE_API_IMPORT@

/** Export library symbols. */
#define VIDRE_API_EXPORT @VIDRE_API_EXPORT@

/** Export library symbols. */
#define VIDRE_API_MODULE @VIDRE_API_MODULE@

/** File extension for dynamically linked libraries.  */
#define VIDRE_DLL_EXTENSION "@VIDRE_DLL_EXTENSION@"

///@}

/**@defgroup api-config-storage Memory and storage settings.
 * @ingroup api-config
 * */
///@{

/** Default size for storage cache (default: 1 MiB). 
 * @note At the moment of writing, chunk sizes for writing data efficiently
 *       to an SSD disk appear to be in the oder of 1 MiB.
 * */
#define VIDRE_CACHE_SIZE @VIDRE_CACHE_SIZE@

/** Default number of cache slots.
 * */
#define VIDRE_CACHE_SLOTS @VIDRE_CACHE_SLOTS@

/** Default timeout for caching operations.
 * */
#define VIDRE_CACHE_TIMEOUT_MS @VIDRE_CACHE_TIMEOUT_MS@

///@}

/**@defgroup api-config-have Software support flags
 * @ingroup api-config
 * @details
 * @fileinfo
 * */
///@{

/** Flag if libuuid is used. */
#cmakedefine01 VIDRE_HAVE_LIBUUID

/** DevWareX midlib2 was available during compilation. */
#cmakedefine01 VIDRE_HAVE_MIDLIB2

/** Baser pylon was available during compilation. */
#cmakedefine01 VIDRE_HAVE_PYLON

/** Using STL's \<format\> (otherwise [fmtlib](https://github.com/fmtlib/fmt)). */
#cmakedefine01 VIDRE_USE_CPP_LIB_FORMAT

/** Developer build.
 * This enables some in-build tree functionality which FIXME
 * */
#cmakedefine01 VIDRE_DEVELOP

///@}

#endif // VIDRE_CONFIG_HH
