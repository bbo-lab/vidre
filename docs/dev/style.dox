/** @page dev-style Coding style

## C++

For C++, the coding style is provided in form of a <tt>.clang-format</tt> file. The 
major rules are:
- indentation of 4 space, no tabs,
- maximum width is 132
- preprocessor statements are not indented
- namespaces indent
- braces are in line
- etc.

Example header and source:
@code
/* Copyright ...
 */
#ifndef PROJECT_MODULE_CLASS_H
#define PROJECT_MODULE_CLASS_H
#pragma once

#include <vidre/module/config.hh> //<-- should define VIDRE_EXAMPLE_VISIBILITY
#include <vidre/error.hh>

#include <string>
#include <vector>

namespace vidre {

    namespace style {

        class VIDRE_EXAMPLE_VISIBILITY class_name {
        public:
            explicit class_name(const std::string &name) : name_(name) {
                if (name_.empty()) {
                    throw vidre::exception() << throw_message("Name cannot be empty");
                }
            }

            void process_data(const std::vector<int> &values);

            std::string getname() const noexcept {
                return name_;
            }

            bool isvalid() const noexcept;

        private:
            std::string name_;              ///< The name.
            std::vector<int> cached_data_;  ///< Internal number cache.

            void validate_internal() const;
            bool check_condition(int value) const;
        };

        ///@}

    }  // namespace style

}  // namespace vidre

#endif  // PROJECT_MODULE_CLASS_H
@endcode

@code
/* Copyright ...
 */
#include "style.h"
#include <algorithm>
#include <iostream>

using namespace vidre;

style::class_name::class_name(const std::string &name)

    void style::class_name::process_data(const std::vector<int> &values) {
    for (const auto &value : values) {
        if (checkCondition(value)) {
            cached_data_.push_back(value);
        }
        else {
            std::cout << "Skipping invalid value: " << value << std::endl;
        }
    }

    validateInternal();
}

bool style::class_name::isvalid() const noexcept {
    return !name_.empty() && !cached_data_.empty();
}

void style::class_name::validate_internal() const {
    if (cached_data_.empty()) {
        throw std::runtime_error("No valid data to process");
    }
}

bool style::class_name::check_condition(int value) const {
    return value > 0 && value < 100;
}
@endcode

### Naming Conventions

All names—including classes, structs, enums, functions, methods, and variables—are 
written in **lowercase**.

For clarity and readability, names should be composed of full words separated by 
underscores (e.g., `on_frame_captured`, `add_sink`). For namespaces, the use of
single words is preferred.

**Exceptions:**

- Abbreviations are permitted when they are either universally understood or prevent 
  excessive verbosity (e.g., `cap` for `capabilities`, `stats` for `statistics`).
- Common prefixes such as `is`, `has`, `get`, and `set` do **not** require an underscore 
  when the meaning is immediately clear to the reader (e.g., `isrunning`, `hascap`, `getstats`, `setcap`).

**Member variables** follow the same naming rules and, in addition, end with a 
trailing underscore (e.g., `cap_`, `stats_`, `sinks_`).

