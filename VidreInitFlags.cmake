# FIXME This needs a bit of explanation, and, as well, some toolchain specific
#       flags (-> see -march=native for GCC and Clang might not fit the 
#       destination platform)

if (CMAKE_CXX_COMPILER_ID MATCHES "GNU")
    set(CMAKE_C_FLAGS_DEBUG "-g -O0 -DDEBUG -Wall" CACHE STRING "")
    set(CMAKE_C_FLAGS_RELWITHDEBINFO "-g -O2 -fno-omit-frame-pointer" CACHE STRING "")
    set(CMAKE_C_FLAGS_MINSIZEREL "-Os -DNDEBUG -march=native" CACHE STRING "")
    set(CMAKE_C_FLAGS_RELEASE "-O3 -DNDEBUG -march=native" CACHE STRING "")

    set(CMAKE_CXX_FLAGS_DEBUG "-g -O0 -DDEBUG -Wall" CACHE STRING "")
    set(CMAKE_CXX_FLAGS_RELWITHDEBINFO "-g -O2 -fno-omit-frame-pointer" CACHE STRING "")
    set(CMAKE_CXX_FLAGS_MINSIZEREL "-Os -DNDEBUG -march=native" CACHE STRING "")
    set(CMAKE_CXX_FLAGS_RELEASE "-O3 -DNDEBUG -march=native" CACHE STRING "")

    set(CMAKE_EXE_LINKER_FLAGS_DEBUG "-g" CACHE STRING "")
    set(CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO "-g" CACHE STRING "")

    set(CMAKE_SHARED_LINKER_FLAGS_DEBUG "-g" CACHE STRING "")
    set(CMAKE_SHARED_LINKER_FLAGS_RELWITHDEBINFO "-g" CACHE STRING "")

    set(CMAKE_MODULE_LINKER_FLAGS_DEBUG "-g" CACHE STRING "")
    set(CMAKE_MODULE_LINKER_FLAGS_RELWITHDEBINFO "-g" CACHE STRING "")
elseif (CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    set(CMAKE_C_FLAGS_DEBUG "-g -O0 -DDEBUG -Wall" CACHE STRING "")
    set(CMAKE_C_FLAGS_RELWITHDEBINFO "-g -O2 -fno-omit-frame-pointer" CACHE STRING "")
    set(CMAKE_C_FLAGS_MINSIZEREL "-Os -DNDEBUG -march=native" CACHE STRING "")
    set(CMAKE_C_FLAGS_RELEASE "-O3 -DNDEBUG -march=native" CACHE STRING "")

    set(CMAKE_CXX_FLAGS_DEBUG "-g -O0 -DDEBUG -Wall" CACHE STRING "")
    set(CMAKE_CXX_FLAGS_RELWITHDEBINFO "-g -O2 -fno-omit-frame-pointer" CACHE STRING "")
    set(CMAKE_CXX_FLAGS_MINSIZEREL "-Os -DNDEBUG -march=native" CACHE STRING "")
    set(CMAKE_CXX_FLAGS_RELEASE "-O3 -DNDEBUG -march=native" CACHE STRING "")

    set(CMAKE_EXE_LINKER_FLAGS_DEBUG "-g" CACHE STRING "")
    set(CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO "-g" CACHE STRING "")

    set(CMAKE_SHARED_LINKER_FLAGS_DEBUG "-g" CACHE STRING "")
    set(CMAKE_SHARED_LINKER_FLAGS_RELWITHDEBINFO "-g" CACHE STRING "")

    set(CMAKE_MODULE_LINKER_FLAGS_DEBUG "-g" CACHE STRING "")
    set(CMAKE_MODULE_LINKER_FLAGS_RELWITHDEBINFO "-g" CACHE STRING "")
endif()

